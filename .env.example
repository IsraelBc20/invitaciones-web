NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ── Panel de administración (/admin/galeria) y limpieza de vencidos ──────────
# NO llevan el prefijo NEXT_PUBLIC_: solo existen en el servidor.

# Contraseña del panel /admin/galeria
ADMIN_PASSWORD=tu_password_aqui

# Token para llamar a POST /api/cleanup-expired desde un cron externo
# (header: Authorization: Bearer <este_token>)
CLEANUP_SECRET_TOKEN=token_largo_aleatorio

# Service role key de Supabase (Dashboard → Settings → API → service_role).
# Necesaria para BORRAR archivos y filas: la anon key no puede (RLS).
# ¡Secreta! Nunca exponerla en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
